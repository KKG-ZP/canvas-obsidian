{
	"name": "obsidian-cursor-canvas",
	"version": "1.0.0",
	"description": "Open Cursor .canvas.tsx files as live canvases in Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"cursor",
		"canvas"
	],
	"license": "MIT",
	"dependencies": {
		"@mantine/charts": "^7.17.8",
		"@mantine/core": "^7.17.8",
		"@thisismydesign/cursor-canvas-web": "^0.3.0",
		"acorn": "^8.18.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"recharts": "^2.15.4",
		"sucrase": "^3.35.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"esbuild": "0.25.5",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"postcss": "^8.5.28",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}
